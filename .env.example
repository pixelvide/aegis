# Aegis Server Configuration
# Copy this file to .env and edit as needed.

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegis?sslmode=disable

# PostgreSQL credentials (for Docker Compose)
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis

# ── Auth ─────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
# If not set, an ephemeral secret is auto-generated (sessions won't survive restart).
JWT_SECRET=

# ── Server ───────────────────────────────────────────────────────
# Server port (default: 8080)
AEGIS_PORT=8080

# Bind address — use 0.0.0.0 inside Docker, 127.0.0.1 for local dev
# AEGIS_BIND=127.0.0.1

# ── Agent & Domain ───────────────────────────────────────────────
# Base domain for subdomain-based org resolution (optional)
# e.g., "aegis.io" means orgs are accessed via acme.aegis.io
# Leave empty to use X-Org-Slug header instead (dev mode)
# AEGIS_BASE_DOMAIN=

# ── CORS ─────────────────────────────────────────────────────────
# Allowed CORS origins (comma-separated)
AEGIS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ── SMTP (Email) ─────────────────────────────────────────────────
# In development, MailDev runs via Docker Compose (web UI: http://localhost:1080)
# In production, configure a real SMTP provider (SendGrid, SES, Mailgun, etc.)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@aegis.local
SMTP_TLS=false
